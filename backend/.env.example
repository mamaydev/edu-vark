NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://eduvark:eduvark@localhost:5432/eduvark

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=12h
SESSION_IDLE_TTL=8h
SESSION_ABSOLUTE_TTL=12h

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_SIGNED_URL_TTL_SECONDS=300
# Development-only fallback when all R2_* values are empty; production requires R2.
PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api/v1
LOCAL_STORAGE_DIR=storage
MAX_UPLOAD_BYTES=104857600
# Antrean penghapusan objek R2 (hapus/ganti berkas materi). Interval 0 mematikan
# worker; percobaan maksimum menentukan kapan pekerjaan ditandai FAILED.
STORAGE_DELETION_INTERVAL_MS=60000
STORAGE_DELETION_MAX_ATTEMPTS=10
# Origin web yang diizinkan (dipisah koma). Kosongkan untuk menolak semua origin
# (aplikasi Android tidak memerlukan CORS).
CORS_ORIGINS=

LOG_LEVEL=info

ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=ChangeMe123456
ADMIN_FULL_NAME=Administrator
