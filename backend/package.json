{
  "name": "eduvark-backend",
  "version": "0.1.0",
  "private": true,
  "description": "EduVARK REST API foundation (Express + TypeScript)",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && npm run copy:migrations",
    "copy:migrations": "node -e \"const fs=require('fs');fs.cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed-admin": "tsx src/db/seed-admin.ts",
    "storage:backlog:dry-run": "tsx src/scripts/backlog-object-cleanup.ts",
    "storage:backlog:execute": "tsx src/scripts/backlog-object-cleanup.ts --execute"
  },
  "allowScripts": {
    "argon2@0.45.2": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1173.0",
    "@aws-sdk/s3-request-presigner": "3.1173.0",
    "argon2": "0.45.2",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
