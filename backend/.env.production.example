NODE_ENV=production
PORT=3000
# PostgreSQL homelab berjalan sebagai container pada network compose yang sama.
DATABASE_URL=postgresql://eduvark:PASSWORD@postgres:5432/eduvark
# Jika memakai PostgreSQL terkelola (mis. Supabase), gunakan bentuk di bawah dan sslmode=require:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_ACCESS_SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER
JWT_REFRESH_SECRET=GANTI_DENGAN_SECRET_ACAK_LAIN_MINIMAL_32_KARAKTER
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=12h
SESSION_IDLE_TTL=8h
SESSION_ABSOLUTE_TTL=12h
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=ISI_ACCESS_KEY
R2_SECRET_ACCESS_KEY=ISI_SECRET_KEY
R2_BUCKET=ISI_NAMA_BUCKET
R2_SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=104857600
# Production menolak start bila JWT secret kosong/sama atau konfigurasi R2 tidak lengkap.
CORS_ORIGINS=
LOG_LEVEL=info
