# Nilai untuk docker-compose.homelab.yml. Salin menjadi .env (jangan di-commit).
# Database dan user sudah dipin di compose (eduvark/eduvark) mengikuti volume
# yang sudah ada, jadi hanya password yang dikonfigurasi di sini.
# Password ini hanya dipakai saat volume PostgreSQL dibuat pertama kali; pada
# volume yang sudah ada nilainya diabaikan, tetapi harus tetap sama dengan
# password pada DATABASE_URL di backend/.env.production.
POSTGRES_PASSWORD=change-me
# Tag image backend yang dibangun dari repo ini.
BACKEND_TAG=testing
# Alamat publish port backend (harus IP LXC agar hanya Traefik yang mengakses).
BACKEND_BIND_ADDRESS=192.168.0.100
