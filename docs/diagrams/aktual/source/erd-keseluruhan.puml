@startuml
!pragma layout smetana
skinparam dpi 160
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 65
skinparam entity {
 BackgroundColor #F0F6FF
 BorderColor #325882
 FontColor #15324F
}
hide circle
title EduVARK | ERD keseluruhan - kunci dan relasi fisik
entity "users" as users {
  * id : uuid <<PK>>
  * role : text
  * status : text
}
entity "classes" as classes {
  * id : uuid <<PK>>
}
entity "enrollments" as enrollments {
  * id : uuid <<PK>>
  * class_id : uuid <<FK>>
  * student_id : uuid <<FK>>
  * status : text
}
entity "teaching_assignments" as teaching_assignments {
  * id : uuid <<PK>>
  * class_id : uuid <<FK>>
  * lecturer_id : uuid <<FK>>
}
entity "auth_sessions" as auth_sessions {
  * id : uuid <<PK>>
  * user_id : uuid <<FK>>
    vark_type : text
}
entity "topics" as topics {
  * id : uuid <<PK>>
  * class_id : uuid <<FK>>
  * created_by : uuid <<FK>>
  * sort_order : integer
  * status : text
}
entity "materials" as materials {
  * id : uuid <<PK>>
  * topic_id : uuid <<FK>>
  * uploaded_by : uuid <<FK>>
  * vark_type : text
}
entity "feedback" as feedback {
  * id : uuid <<PK>>
  * student_id : uuid <<FK>>
  * topic_id : uuid <<FK>>
  * vark_type : text
  * value : integer
}
entity "case_studies" as case_studies {
  * id : uuid <<PK>>
  * topic_id : uuid <<FK>>
  * created_by : uuid <<FK>>
  * deadline_at : timestamptz
}
entity "submissions" as submissions {
  * id : uuid <<PK>>
  * case_study_id : uuid <<FK>>
  * student_id : uuid <<FK>>
}
entity "assessments" as assessments {
  * id : uuid <<PK>>
  * submission_id : uuid <<FK>>
  * assessed_by : uuid <<FK>>
  * score : integer
}
entity "audit_logs" as audit_logs {
  * id : uuid <<PK>>
    actor_id : uuid <<FK>>
}
classes ||--o{ enrollments : class_id
users ||--o{ enrollments : student_id
classes ||--o{ teaching_assignments : class_id
users ||--o{ teaching_assignments : lecturer_id
users ||--o{ auth_sessions : user_id
classes ||--o{ topics : class_id
users ||--o{ topics : created_by
topics ||--o{ materials : topic_id
users ||--o{ materials : uploaded_by
users ||--o{ feedback : student_id
topics ||--o{ feedback : topic_id
topics ||--o{ case_studies : topic_id
users ||--o{ case_studies : created_by
case_studies ||--o{ submissions : case_study_id
users ||--o{ submissions : student_id
submissions ||--o| assessments : submission_id
users ||--o{ assessments : assessed_by
users |o--o{ audit_logs : actor_id
note bottom of case_studies
Maksimal satu kasus non-deleted per topik.
Riwayat soft-delete membuat FK fisik 1:N.
end note
note bottom of auth_sessions
Maksimal satu sesi is_active per user.
VARK write-once setelah dipilih.
end note
note bottom of feedback
UNIQUE(student_id, topic_id, vark_type)
V/A/R saja; integer 0..100.
end note
note bottom of submissions
UNIQUE(student_id, case_study_id)
Jawaban final 1..10.000 karakter.
end note
entity schema_migrations #F4F4F4 {
 * id : text <<PK>>
 * applied_at : timestamptz
}
legend bottom left
  PK = primary key; FK = foreign key; * = NOT NULL.
  Crow's foot: || tepat satu; o| nol/satu; o{ nol/banyak.
  Relasi menunjuk FK fisik; pembatasan role ditegakkan layanan.
  schema_migrations adalah tabel teknis dan ditampilkan terpisah.
endlegend
@enduml
